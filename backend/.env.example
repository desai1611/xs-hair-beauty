# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== MongoDB =====
# Local dev: mongodb://127.0.0.1:27017/xs-hair-beauty
# Production: MongoDB Atlas connection string (see README > Deployment)
MONGO_URI=mongodb://127.0.0.1:27017/xs-hair-beauty

# ===== JWT =====
# Generate a strong random string, e.g: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ===== CORS =====
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ===== Email (Nodemailer) =====
# Gmail: use a 16-character App Password (Google Account > Security > App Passwords),
# NOT your normal Gmail password. Requires 2-Step Verification enabled on the account.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-salon-email@gmail.com
EMAIL_PASS=your-16-char-app-password
# Where booking/contact notifications are sent (usually the same as EMAIL_USER)
SALON_NOTIFICATION_EMAIL=your-salon-email@gmail.com

# ===== Salon contact details (used in the customer confirmation email) =====
SALON_PHONE_DISPLAY=0022 342 3964
SALON_WHATSAPP=223423964
SALON_ADDRESS=23 Chartwell Avenue, Glenfield, Auckland 0629, New Zealand

# ===== Initial admin account (used by the seed script only) =====
SEED_ADMIN_NAME=Mayur Maysuria
SEED_ADMIN_EMAIL=admin@xshairandbeauty.co.nz
SEED_ADMIN_PASSWORD=change-this-password
