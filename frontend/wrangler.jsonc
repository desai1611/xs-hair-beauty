{
  // Cloudflare Workers config: publishes the built site (frontend/dist).
  // "single-page-application" makes links like /contact work when opened directly
  // (same job vercel.json does on Vercel).
  "name": "xs-hair-beauty",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
